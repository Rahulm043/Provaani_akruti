# Provaani Production Environment Template
# Copy to .env and fill in real values:  cp .env.example .env
# Generate secrets with:  python3 -c "import secrets; print(secrets.token_hex(24))"

ENVIRONMENT=production
ENABLE_SIGNUP=false

# Core Secrets (MUST be cryptographically random — NEVER use defaults)
OSS_JWT_SECRET=<GENERATE_64_CHAR_HEX>
POSTGRES_PASSWORD=<GENERATE_48_CHAR_HEX>
REDIS_PASSWORD=<GENERATE_48_CHAR_HEX>
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=<GENERATE_48_CHAR_HEX>

# Concurrency & Workers
DEFAULT_ORG_CONCURRENCY_LIMIT=5
FASTAPI_WORKERS=1

# Networking (replace with your VM's static IP)
PUBLIC_HOST=<EXTERNAL_STATIC_IP>
PUBLIC_BASE_URL=http://<EXTERNAL_STATIC_IP>:8000
BACKEND_API_ENDPOINT=http://<EXTERNAL_STATIC_IP>:8000

# AI Provider API Keys (for warmup daemon — also configured in Dograh org settings UI)
CEREBRAS_API_KEY=<YOUR_CEREBRAS_API_KEY>
SMALLEST_API_KEY=<YOUR_SMALLEST_API_KEY>
